{
  "name": "aws-ca",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck",
    "test": "jest --coverage",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:deploy": "cdk deploy",
    "cdk:destroy": "cdk destroy",
    "local:scep": "tsx scripts/local-scep.ts",
    "local:est": "tsx scripts/local-est.ts",
    "test:aws": "tsx scripts/test-aws.ts",
    "test:aws:stack": "tsx scripts/test-aws.ts --yes stack",
    "test:aws:cloudfront": "tsx scripts/test-aws.ts --yes cloudfront"
  },
  "dependencies": {
    "@peculiar/asn1-cms": "^2.10.0",
    "@peculiar/asn1-ocsp": "^2.10.0",
    "@peculiar/asn1-rsa": "^2.10.0",
    "@peculiar/asn1-schema": "^2.10.0",
    "@peculiar/asn1-x509": "^2.10.0",
    "@peculiar/x509": "^1.14.3",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.5.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-kms": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@aws-sdk/client-ssm": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@swc/core": "1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.152",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1145.0",
    "aws-sdk-client-mock": "^4.1.0",
    "cdk-nag": "^3.0.2",
    "esbuild": "^0.28.2",
    "jest": "^30",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
